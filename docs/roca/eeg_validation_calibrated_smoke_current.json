{
  "protocol": "EEG validation-calibrated multitask residual smoke",
  "target": "arousal",
  "cache": "baseline_corrected",
  "models": [
    "stimulus_fit_only",
    "eeg_multitask_uncalibrated_inner",
    "eeg_multitask_val_affine_calibrated_inner"
  ],
  "baseline_note": "stimulus_fit_only uses fit-subject stimulus means only, because validation subjects are reserved for calibration.",
  "epochs_max": 50,
  "patience": 8,
  "max_folds": 6,
  "test_subjects": [
    1,
    2,
    3,
    5,
    6,
    7
  ],
  "validation_subject_count": 8,
  "loss": {
    "residual": "HuberLoss(delta=1.0) on scaled residual",
    "auxiliary": "BCEWithLogitsLoss on raw high/low score label",
    "lambda_bce": 0.25
  },
  "calibration": {
    "type": "validation affine residual calibration",
    "formula": "pred_dev_calibrated = a * pred_dev + b",
    "fit_scope": "validation subjects only, inside outer train fold",
    "ridge": 1e-06,
    "max_abs_slope": 20.0
  },
  "optimizer": {
    "name": "AdamW",
    "lr": 0.0001,
    "weight_decay": 0.001
  },
  "device": {
    "torch": "2.11.0+cu128",
