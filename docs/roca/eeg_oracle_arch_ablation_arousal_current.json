{
  "protocol": "EEG oracle architecture ablation over existing modular EEGSegmentClassifier",
  "target": "arousal",
  "cache": "baseline_corrected",
  "augmentation_config": "gaussian_0p10",
  "arch_configs": {
    "A0_current": {
      "description": "Current model config: lite + GN + concat stem + learnable channel position + MHA mixer.",
      "modelsize": "lite",
      "norm_kind": "gn",
      "stem_fusion": "concat",
      "channel_pos_mode": "learnable",
      "channel_mixer": "mha",
      "dropout": 0.1,
      "head_dropout": 0.3
    },
    "A1_low_dropout": {
      "description": "Same as current, but lower regularization. Tests underfitting.",
      "modelsize": "lite",
      "norm_kind": "gn",
      "stem_fusion": "concat",
      "channel_pos_mode": "learnable",
      "channel_mixer": "mha",
      "dropout": 0.05,
      "head_dropout": 0.1
    },
    "A2_high_dropout": {
      "description": "Same as current, but higher regularization. Tests overfitting/noisy checkpointing.",
      "modelsize": "lite",
      "norm_kind": "gn",
      "stem_fusion": "concat",
      "channel_pos_mode": "learnable",
      "channel_mixer": "mha",
      "dropout": 0.2,
      "head_dropout": 0.4
    },
    "A3_batchnorm": {
      "description": "Swap GroupNorm to BatchNorm inside temporal blocks/stem.",
      "modelsize": "lite",
      "norm_kind": "bn",
      "stem_fusion": "concat",
      "channel_pos_mode": "learnable",
      "channel_mixer": "mha",
      "dropout": 0.1,
      "head_dropout": 0.3
    },
    "A4_stem_sum": {
      "description": "Use sum fusion for temporal branches instead of concat projection.",
      "modelsize": "lite",
      "norm_kind": "gn",
      "stem_fusion": "sum",
      "channel_pos_mode": "learnable",
      "channel_mixer": "mha",
      "dropout": 0.1,
      "head_dropout": 0.3
    },
    "A5_stem_attn": {
      "description": "Use learned attention over temporal branches.",
      "modelsize": "lite",
      "norm_kind": "gn",
      "stem_fusion": "attn",
      "channel_pos_mode": "learnable",
      "channel_mixer": "mha",
      "dropout": 0.1,
      "head_dropout": 0.3
    },
    "A6_stem_moe": {
      "description": "Use lightweight MoE-style gate over temporal branches.",
      "modelsize": "lite",
      "norm_kind": "gn",
      "stem_fusion": "moe",
      "channel_pos_mode": "learnable",
      "channel_mixer": "mha",
      "dropout": 0.1,
      "head_dropout": 0.3
    },
    "A7_no_channel_mha": {
      "description": "Disable channel self-attention mixer. Tests whether MHA is noisy/overfitting.",
      "modelsize": "lite",
      "norm_kind": "gn",
      "stem_fusion": "concat",
      "channel_pos_mode": "learnable",
      "channel_mixer": "none",
      "dropout": 0.1,
      "head_dropout": 0.3
    },
    "A8_no_channel_pos": {
      "description": "Disable learned channel identity embedding.",
      "modelsize": "lite",
      "norm_kind": "gn",
      "stem_fusion": "concat",
      "channel_pos_mode": "none",
      "channel_mixer": "mha",
      "dropout": 0.1,
      "head_dropout": 0.3
    },
    "A9_base_capacity": {
      "description": "Use base encoder capacity instead of lite. Tests undercapacity vs overfitting.",
      "modelsize": "base",
      "norm_kind": "gn",
      "stem_fusion": "concat",
      "channel_pos_mode": "learnable",
      "channel_mixer": "mha",
      "dropout": 0.1,
      "head_dropout": 0.3
    },
    "A10_lr_low": {
      "description": "Current architecture with lower LR=3e-5.",
      "modelsize": "lite",
      "norm_kind": "gn",
      "stem_fusion": "concat",
      "channel_pos_mode": "learnable",
      "channel_mixer": "mha",
      "dropout": 0.1,
      "head_dropout": 0.3,
      "lr": 3e-05
    },
    "A11_lr_high": {
